<?xml version="1.0" encoding="utf-8"?>
<!--
  Dashboard (D4) — Watch Face Format (WFF) XML
  Data-dense cockpit dashboard styling with amber & slate accents.
-->
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="10:08:32" />

    <Scene backgroundColor="#FF111827">
        <!-- Inner cockpit frame -->
        <PartDraw x="0" y="0" width="450" height="450">
            <Arc centerX="225" centerY="225" startAngle="0" endAngle="360" innerRadius="210" outerRadius="218" direction="CLOCKWISE">
                <Stroke color="#FFF59E0B" cap="BUTT" />
            </Arc>
        </PartDraw>

        <!-- Weather -->
        <ComplicationSlot x="145" y="55" width="160" height="40" slotId="100" supportedTypes="SHORT_TEXT" name="Pogoda">
            <DefaultProviderPolicy defaultSystemProvider="WEATHER" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingOval x="0" y="0" width="160" height="40" />
        </ComplicationSlot>

        <!-- Digital Clock -->
        <DigitalClock x="75" y="115" width="300" height="100">
            <TimeText format="HH:mm" align="CENTER" size="76" color="#FFF59E0B" font="SYNC_TO_DEVICE" weight="BOLD" />
        </DigitalClock>

        <DigitalClock x="140" y="225" width="170" height="28">
            <TimeText format="EEE, dd MMM" align="CENTER" size="15" color="#FF9CA3AF" font="SYNC_TO_DEVICE" />
        </DigitalClock>

        <!-- Glucose & Trend -->
        <ComplicationSlot x="80" y="270" width="100" height="60" slotId="200" supportedTypes="SHORT_TEXT,RANGED_VALUE" name="Glukoza">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingOval x="0" y="0" width="100" height="60" />
        </ComplicationSlot>

        <ComplicationSlot x="185" y="270" width="50" height="60" slotId="201" supportedTypes="SHORT_TEXT,SMALL_IMAGE,MONOCHROMATIC_IMAGE" name="Trend glukozy">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingOval x="0" y="0" width="50" height="60" />
        </ComplicationSlot>

        <ComplicationSlot x="255" y="270" width="60" height="60" slotId="202" supportedTypes="SMALL_IMAGE,SHORT_TEXT" name="Multimedia">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SMALL_IMAGE" />
            <BoundingOval x="0" y="0" width="60" height="60" />
        </ComplicationSlot>

        <!-- Corners -->
        <ComplicationSlot x="40" y="45" width="80" height="45" slotId="10" supportedTypes="SHORT_TEXT,RANGED_VALUE" name="Lewy górny">
            <DefaultProviderPolicy defaultSystemProvider="STEP_COUNT" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingOval x="0" y="0" width="80" height="45" />
        </ComplicationSlot>

        <ComplicationSlot x="330" y="45" width="80" height="45" slotId="11" supportedTypes="SHORT_TEXT,RANGED_VALUE" name="Prawy górny">
            <DefaultProviderPolicy defaultSystemProvider="WATCH_BATTERY" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingOval x="0" y="0" width="80" height="45" />
        </ComplicationSlot>

        <ComplicationSlot x="40" y="360" width="80" height="45" slotId="12" supportedTypes="SHORT_TEXT,RANGED_VALUE" name="Lewy dolny">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingOval x="0" y="0" width="80" height="45" />
        </ComplicationSlot>

        <ComplicationSlot x="330" y="360" width="80" height="45" slotId="13" supportedTypes="SHORT_TEXT,RANGED_VALUE" name="Prawy dolny">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingOval x="0" y="0" width="80" height="45" />
        </ComplicationSlot>
    </Scene>
</WatchFace>
