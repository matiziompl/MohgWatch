<?xml version="1.0" encoding="utf-8"?>
<!--
  Swiss Heritage (A1) — Watch Face Format (WFF) XML
  Classic elegant Swiss analog watch design with polished hands and dial ticks.
-->
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="ANALOG" />
    <Metadata key="PREVIEW_TIME" value="10:08:32" />

    <Scene backgroundColor="#FF0F172A">
        <!-- Outer bezel ring -->
        <PartDraw x="0" y="0" width="450" height="450">
            <Arc centerX="225" centerY="225" startAngle="0" endAngle="360" innerRadius="215" outerRadius="222" direction="CLOCKWISE">
                <Stroke color="#FFD1D5DB" cap="ROUND" />
            </Arc>
        </PartDraw>

        <!-- Weather (top dial position) -->
        <ComplicationSlot x="145" y="70" width="160" height="40" slotId="100" supportedTypes="SHORT_TEXT" name="Pogoda">
            <DefaultProviderPolicy defaultSystemProvider="WEATHER" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingOval x="0" y="0" width="160" height="40" />
        </ComplicationSlot>

        <!-- Analog Clock Hands -->
        <AnalogClock x="0" y="0" width="450" height="450">
            <HourHand x="215" y="65" width="20" height="160" pivotX="10" pivotY="160">
                <PartDraw x="0" y="0" width="20" height="160">
                    <Line startX="10" startY="20" endX="10" endY="160">
                        <Stroke color="#FFFFFFFF" cap="ROUND" width="8" />
                    </Line>
                </PartDraw>
            </HourHand>

            <MinuteHand x="217" y="35" width="16" height="190" pivotX="8" pivotY="190">
                <PartDraw x="0" y="0" width="16" height="190">
                    <Line startX="8" startY="10" endX="8" endY="190">
                        <Stroke color="#FFE5E7EB" cap="ROUND" width="5" />
                    </Line>
                </PartDraw>
            </MinuteHand>

            <SecondHand x="223" y="25" width="4" height="200" pivotX="2" pivotY="200">
                <PartDraw x="0" y="0" width="4" height="200">
                    <Line startX="2" startY="0" endX="2" endY="200">
                        <Stroke color="#FFEF4444" cap="ROUND" width="2" />
                    </Line>
                </PartDraw>
            </SecondHand>
        </AnalogClock>

        <!-- Glucose & Trend (bottom dial position) -->
        <ComplicationSlot x="80" y="280" width="100" height="60" slotId="200" supportedTypes="SHORT_TEXT,RANGED_VALUE" name="Glukoza">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingOval x="0" y="0" width="100" height="60" />
        </ComplicationSlot>

        <ComplicationSlot x="185" y="280" width="50" height="60" slotId="201" supportedTypes="SHORT_TEXT,SMALL_IMAGE,MONOCHROMATIC_IMAGE" name="Trend glukozy">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingOval x="0" y="0" width="50" height="60" />
        </ComplicationSlot>

        <ComplicationSlot x="255" y="280" width="60" height="60" slotId="202" supportedTypes="SMALL_IMAGE,SHORT_TEXT" name="Multimedia">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SMALL_IMAGE" />
            <BoundingOval x="0" y="0" width="60" height="60" />
        </ComplicationSlot>

        <!-- Corners -->
        <ComplicationSlot x="40" y="45" width="80" height="45" slotId="10" supportedTypes="SHORT_TEXT,RANGED_VALUE" name="Lewy górny">
            <DefaultProviderPolicy defaultSystemProvider="STEP_COUNT" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingOval x="0" y="0" width="80" height="45" />
        </ComplicationSlot>

        <ComplicationSlot x="330" y="45" width="80" height="45" slotId="11" supportedTypes="SHORT_TEXT,RANGED_VALUE" name="Prawy górny">
            <DefaultProviderPolicy defaultSystemProvider="WATCH_BATTERY" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingOval x="0" y="0" width="80" height="45" />
        </ComplicationSlot>

        <ComplicationSlot x="40" y="360" width="80" height="45" slotId="12" supportedTypes="SHORT_TEXT,RANGED_VALUE" name="Lewy dolny">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingOval x="0" y="0" width="80" height="45" />
        </ComplicationSlot>

        <ComplicationSlot x="330" y="360" width="80" height="45" slotId="13" supportedTypes="SHORT_TEXT,RANGED_VALUE" name="Prawy dolny">
            <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingOval x="0" y="0" width="80" height="45" />
        </ComplicationSlot>
    </Scene>
</WatchFace>
